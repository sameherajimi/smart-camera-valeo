# ============================================================
# VALEO INTELLIGENT CAMERA - .gitignore
# ============================================================

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
.pytest_cache/
.cache/

# Builds & Distributions
build/
dist/
*.egg-info/

# Base de données locales / SQLite générées au runtime
*.sqlite3
*.db

# Fichiers et dossiers temporaires
.tmp/
.tmp_excel_inspect.py

# Environnements et secrets
.env
.env.local
.env.*.local
secrets/
*.pem
*.key

# IDE & Système
.vscode/
.idea/
*.iml
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Captures d'images générées au runtime
server/captures/*
!server/captures/.gitkeep
captures/

# Example environment variables for Valeo project
# Copy this file to .env and fill values, then DO NOT commit .env

# Roboflow API keys
VALEO_ROBOFLOW_API_KEY=your_roboflow_api_key_here
VALEO_ROBOFLOW_SECOND_API_KEY=your_second_key_here

# Admin credentials (for local/dev only — do not use in production)
ADMIN_LOGIN=ADMIN-001
ADMIN_PASSWORD=choose_a_secure_password

# Server settings
PORT=3000
NODE_ENV=development
